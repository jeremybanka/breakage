{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"lib": [
			"ES2024"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": [
			"node"
		]
	},
	"include": [
		"**/*.ts",
		"*.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"coverage",
		"packages/breakage/__tests__/fixtures/npm",
		"packages/breakage/tests/public/fixtures/npm"
	]
}
