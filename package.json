{
	"name": "@breakage/workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"build:release": "vp run @breakage/changesets#build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:spelling": "cspell .",
		"check:vp": "vp run check:vp:run",
		"fmt": "dprint fmt",
		"prepare": "vp config --hooks --no-agent",
		"release:publish": "pnpm run build:release && changeset publish",
		"release:version": "changeset version",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:breakage": "pnpm run build:release && node scripts/check-compatibility.node.ts",
		"test:breakage:npm": "vp run @breakage/changesets#test:breakage:npm",
		"test:prepare": "vp run -r test:prepare",
		"test:public": "vp run -r test:public",
		"test:watch": "vp run -r test:watch",
		"workflows:update": "node scripts/update-workflows.node.ts"
	},
	"devDependencies": {
		"@breakage/changesets": "workspace:*",
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.48.0",
		"@dprint/toml": "0.9.0",
		"@types/node": "26.6.5",
		"breakage": "workspace:*",
		"breakage-supervisor": "npm:breakage@0.8.2",
		"cspell": "10.4.0",
		"dprint": "0.64.3",
		"dprint-plugin-yaml": "0.6.0",
		"turbo": "2.11.10",
		"typescript": "7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "26.13.0",
		"pnpm": "12.16.1"
	}
}
