{
	"extends": "../../tsconfig.json",
	"include": [
		"src",
		"__tests__",
		"tests",
		"**/*.config.ts"
	],
	"compilerOptions": {
		"allowJs": false,
		"types": [
			"bun",
			"node"
		],
		"target": "ES2022"
	},
	"exclude": [
		"node_modules",
		"dist",
		"coverage",
		"__tests__/fixtures/npm",
		"tests/public/fixtures/npm"
	]
}
