{
	"extends": "../../tsconfig.json",
	"include": [
		"src",
		"__tests__",
		"tests",
		"**/*.config.ts"
	],
	"compilerOptions": {
		"paths": {
			"breakage": ["./src/breakage.ts"]
		},
		"allowJs": false,
		"declaration": true,
		"isolatedDeclarations": true,
		"types": [
			"bun",
			"node"
		],
		"target": "ES2022"
	}
}
