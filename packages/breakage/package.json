{
	"name": "breakage",
	"version": "0.8.4",
	"description": "Run yesterday’s tests against tomorrow’s release.",
	"homepage": "https://github.com/jeremybanka/breakage#readme",
	"bugs": "https://github.com/jeremybanka/breakage/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/breakage.git",
		"directory": "packages/breakage"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/breakage.js",
	"types": "dist/breakage.d.ts",
	"bin": {
		"breakage": "./dist/breakage.x.js"
	},
	"files": [
		"npm.md",
		"dist",
		"src"
	],
	"scripts": {
		"build": "vp pack && pnpm run schema",
		"check": "pnpm --dir ../.. run check",
		"postversion": "dprint fmt package.json",
		"schema": "bun src/breakage.x.ts --outdir=dist -- schema",
		"test": "vp run suite",
		"test:public": "BREAKAGE_CLI_ENTRYPOINT=./src/breakage.x.ts bun test -- ./tests/public",
		"test:watch": "vp run suite --watch"
	},
	"dependencies": {
		"arktype": "2.2.8",
		"comline": "0.9.0",
		"minimatch": "10.2.6",
		"semver": "7.8.5",
		"simple-git": "4.0.2",
		"takua": "0.2.3"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.3",
		"@types/semver": "7.8.0",
		"typescript": "7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
