{
	"name": "breakage",
	"version": "0.10.0",
	"description": "Run yesterday\u2019s tests against tomorrow\u2019s release.",
	"homepage": "https://github.com/jeremybanka/breakage#readme",
	"bugs": "https://github.com/jeremybanka/breakage/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/breakage.git",
		"directory": "packages/breakage"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/breakage.d.ts",
			"default": "./dist/breakage.js"
		},
		"./*": "./*"
	},
	"main": "dist/breakage.js",
	"types": "dist/breakage.d.ts",
	"bin": {
		"breakage": "./dist/breakage.x.js"
	},
	"files": [
		"npm.md",
		"dist",
		"src"
	],
	"scripts": {
		"build": "vp pack",
		"check": "vp run -w check",
		"postversion": "dprint fmt package.json",
		"test": "vp run test:run",
		"test:public": "vp run test:public:run",
		"test:watch": "vp run test:run --watch"
	},
	"dependencies": {
		"arktype": "2.2.9",
		"comline": "0.9.3",
		"minimatch": "11.0.1",
		"semver": "7.8.5",
		"simple-git": "4.0.2",
		"takua": "0.2.3"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.4",
		"@types/semver": "7.8.0",
		"typescript": "7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
