{
	"name": "breakage",
	"version": "0.8.1",
	"description": "Run yesterday’s tests against tomorrow’s release.",
	"homepage": "https://github.com/jeremybanka/breakage#readme",
	"bugs": "https://github.com/jeremybanka/breakage/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/breakage.git",
		"directory": "packages/breakage"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/breakage.js",
	"types": "dist/breakage.d.ts",
	"bin": {
		"breakage": "./dist/breakage.x.js"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown && pnpm run schema",
		"check": "pnpm run check:tsc",
		"check:tsc": "tsc --noEmit",
		"postversion": "dprint fmt package.json",
		"schema": "bun src/breakage.x.ts --outdir=dist -- schema",
		"pretest": "pnpm run build",
		"test": "bun test -- ./__tests__",
		"test:watch": "bun test --watch -- ./__tests__"
	},
	"dependencies": {
		"arktype": "2.2.7",
		"comline": "0.9.0",
		"minimatch": "10.2.6",
		"simple-git": "4.0.2",
		"takua": "0.2.3"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.2",
		"tsdown": "0.23.0",
		"typescript": "7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
